# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.egg-info/
*.egg
*.log

# --- Virtual environments ---
.venv/
venv/
env/

# --- uv (package manager) ---
.uv/
.uv_cache/
.uv_lock/

# --- FastAPI / Uvicorn ---
