*.pid

# --- Environment variables ---
.env
.env.*
*.env

# --- IDE / Editor ---
.vscode/
.idea/
*.swp

# --- Bytecode cache ---
.pytest_cache/
.mypy_cache/
.cache/

# --- Testing ---
.coverage
htmlcov/
pytestdebug.log

# --- Build / Distribution ---
build/
dist/
site/
wheelhouse/

# --- Databases (if using SQLite locally) ---
*.db
*.sqlite3

# --- Alembic (if using migrations) ---
alembic/versions/*.pyc
alembic/versions/__pycache__/

# --- OS-specific ---
.DS_Store
Thumbs.db
